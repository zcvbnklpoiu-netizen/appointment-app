NEXT_PUBLIC_APP_NAME="MediaBook"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_PATH="/appointment-app"

DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
# PostgreSQL deployments: set DATABASE_PROVIDER="postgresql" and use your provider's pooled URL above.
# Optional direct URL for migrations when the pooled connection is unsuitable.
# DIRECT_URL="postgresql://<user>:<password>@<host>:5432/<database>"
BETTER_AUTH_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Required only when creating the first administrator with npm run admin:create.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Optional. Use international digits only, without a plus sign or punctuation.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
