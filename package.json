{
  "name": "appointment-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/appointment-validation.test.js tests/availability-calendar.test.js tests/contact-validation.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/ensure-sqlite-db.mjs && prisma migrate dev",
    "db:deploy": "node scripts/ensure-sqlite-db.mjs && prisma migrate deploy",
    "db:studio": "prisma studio",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "admin:password:reset": "node --env-file=.env scripts/reset-admin-password.mjs",
    "test:integration": "node --test tests/api.integration.test.js",
    "prebuild": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/prisma-adapter": "^1.7.10",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.10",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icon": "^1.0.0",
    "react-icons": "^5.7.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
